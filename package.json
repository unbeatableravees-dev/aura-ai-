{
  "name": "raf",
  "version": "2.0.0",
  "description": "RAF — cyberpunk desktop assistant with a reactive holographic core and JARVIS voice protocol",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "start": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "package:exe": "npm run build && electron-packager . RAF --platform=win32 --arch=x64 --out=release-exe --overwrite --prune=true"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
